; A basic Whale IR module for testing syntax highlighting

module "test_module" {
  target triple = "x86_64-unknown-linux-gnu"
  target datalayout = "e-m:e-i64:64-f80:128-n8:16:32:64-S128"

  func @main(i32 %argc, ptr %argv) i32 {
  ^entry:
    %0 = add i32 %argc, 1
    %1 = icmp eq i32 %0, 2
    cond_br %1, ^then, ^else

  ^then:
    ret i32 0

  ^else:
    ret i32 1
  }
}
